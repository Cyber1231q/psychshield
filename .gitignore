# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
env/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# Node
node_modules/

# Env files — ignore every variant (.env, .env.local, .env.production, ...)
# but keep the checked-in .example templates tracked.
.env
.env.*
!.env.example
!.env.*.example

# Secrets / credentials (defense-in-depth — none currently present, but a
# stray download or export should never be one `git add .` away from GitHub)
*.pem
*.key
*.p12
*.pfx
client_secret*.json
*serviceaccount*.json

# Claude Code
CLAUDE.md
.claude/

# ML Models (too large for GitHub)
backend/saved_models/*.joblib
backend/saved_models/*.pkl
backend/saved_models/**/*.joblib
backend/saved_models/**/*.pkl
backend/saved_models/**/*.json

# Dataset files (too large for GitHub)
data/phishtank/*.csv
data/enron/
*.csv.gz
verified_online.csv.gz

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp
*.log
.pip_tmp/

# Keep folder structure
!backend/saved_models/.gitkeep
!data/phishtank/.gitkeep
!data/enron/.gitkeep
